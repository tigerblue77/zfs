diff --git a/module/zfs/vdev_queue.c b/module/zfs/vdev_queue.c
index 1e06a407a9a..8648c9463ce 100644
--- a/module/zfs/vdev_queue.c
+++ b/module/zfs/vdev_queue.c
@@ -202,6 +202,20 @@ static uint_t zfs_vdev_nia_credit = 5;
 static uint_t zfs_vdev_queue_window = 0;
 static uint_t zfs_vdev_queue_window_max = 0;
 
+/*
+ * Below that limit, the window: beyond its class's min_active, no I/O is
+ * issued while as many as the window are active.  At the end of a period,
+ * it shrinks by a quarter if more than a tenth of the reads and sync
+ * writes completed in it took longer than the target, from issue to
+ * completion, and otherwise grows by an eighth if it held an I/O back.
+ * A target of 0 leaves the window at the limit.
+ */
+static uint_t zfs_vdev_queue_window_rotating_us = 75000;
+static uint_t zfs_vdev_queue_window_non_rotating_us = 2000;
+
+#define	VDQ_WINDOW_PERIOD_ROTATING	MSEC2NSEC(250)
+#define	VDQ_WINDOW_PERIOD_NON_ROTATING	MSEC2NSEC(20)
+
 /*
  * To reduce IOPs, we aggregate small adjacent I/Os into one large I/O.
  * For read I/Os, we also aggregate across small adjacency gaps; for writes
@@ -428,6 +442,14 @@ vdev_queue_max_active(vdev_queue_t *vq)
 	return (max);
 }
 
+static uint32_t
+vdev_queue_window(vdev_queue_t *vq, uint32_t max)
+{
+	uint32_t w = vq->vq_win_depth;
+
+	return (w == 0 || w > max ? max : w);
+}
+
 /*
  * Return the i/o class to issue from, or ZIO_PRIORITY_NUM_QUEUEABLE if
  * there is no eligible class.
@@ -436,9 +458,10 @@ static zio_priority_t
 vdev_queue_class_to_issue(vdev_queue_t *vq)
 {
 	uint32_t cq = vq->vq_cqueued;
+	uint32_t max = vdev_queue_max_active(vq);
 	zio_priority_t p, p1;
 
-	if (cq == 0 || vq->vq_active >= vdev_queue_max_active(vq))
+	if (cq == 0 || vq->vq_active >= max)
 		return (ZIO_PRIORITY_NUM_QUEUEABLE);
 
 	/*
@@ -469,6 +492,11 @@ vdev_queue_class_to_issue(vdev_queue_t *vq)
 		    vdev_queue_class_max_active(vq, p))
 			break;
 	}
+	if (p < ZIO_PRIORITY_NUM_QUEUEABLE && zfs_vdev_queue_window != 0 &&
+	    vq->vq_active >= vdev_queue_window(vq, max)) {
+		vq->vq_win_held = B_TRUE;
+		p = ZIO_PRIORITY_NUM_QUEUEABLE;
+	}
 
 found:
 	vq->vq_last_prio = p;
@@ -596,6 +624,60 @@ vdev_queue_pending_remove(vdev_queue_t *vq, zio_t *zio)
 	zio->io_queue_state = ZIO_QS_NONE;
 }
 
+/*
+ * Take the latency of a completed read or sync write into the window, and
+ * at the end of a period, adjust the window.  The latency is io_delay, from
+ * issue to completion, which zpool iostat reports as disk_wait.
+ */
+static void
+vdev_queue_window_update(vdev_queue_t *vq, zio_t *zio, hrtime_t now)
+{
+	uint32_t max, w;
+	hrtime_t target, period;
+
+	ASSERT(MUTEX_HELD(&vq->vq_lock));
+
+	if (vq->vq_vdev->vdev_nonrot) {
+		target = USEC2NSEC(zfs_vdev_queue_window_non_rotating_us);
+		period = VDQ_WINDOW_PERIOD_NON_ROTATING;
+	} else {
+		target = USEC2NSEC(zfs_vdev_queue_window_rotating_us);
+		period = VDQ_WINDOW_PERIOD_ROTATING;
+	}
+
+	if (vq->vq_win_depth == 0) {
+		vq->vq_win_depth = MAX(vdev_queue_max_active(vq), 1);
+		vq->vq_win_start = now;
+	}
+
+	switch (zio->io_priority) {
+	case ZIO_PRIORITY_SYNC_READ:
+	case ZIO_PRIORITY_SYNC_WRITE:
+	case ZIO_PRIORITY_ASYNC_READ:
+		vq->vq_win_ios++;
+		if (target != 0 && zio->io_delay > target)
+			vq->vq_win_slow++;
+		break;
+	default:
+		break;
+	}
+
+	if (now - vq->vq_win_start < period)
+		return;
+
+	max = MAX(vdev_queue_max_active(vq), 1);
+	w = vdev_queue_window(vq, max);
+	if (vq->vq_win_slow > vq->vq_win_ios / 10)
+		w -= MIN(w - 1, MAX(1, w / 4));
+	else if (vq->vq_win_held)
+		w = MIN(max, w + MAX(1, w / 8));
+	vq->vq_win_depth = w;
+	vq->vq_win_start = now;
+	vq->vq_win_ios = 0;
+	vq->vq_win_slow = 0;
+	vq->vq_win_held = B_FALSE;
+}
+
 static void
 vdev_queue_agg_io_done(zio_t *aio)
 {
@@ -983,6 +1065,8 @@ vdev_queue_io_done(zio_t *zio)
 
 	mutex_enter(&vq->vq_lock);
 	vdev_queue_pending_remove(vq, zio);
+	if (zfs_vdev_queue_window != 0)
+		vdev_queue_window_update(vq, zio, now);
 
 	while ((nio = vdev_queue_io_to_issue(vq)) != NULL) {
 		mutex_exit(&vq->vq_lock);
@@ -1172,7 +1256,13 @@ ZFS_MODULE_PARAM(zfs_vdev, zfs_vdev_, nia_delay, UINT, ZMOD_RW,
 	"Number of non-interactive I/Os before _max_active");
 
 ZFS_MODULE_PARAM(zfs_vdev, zfs_vdev_, queue_window, UINT, ZMOD_RW,
-	"Limit active I/Os per vdev to its queue depth");
+	"Limit active I/Os per vdev by queue depth and read latency");
 
 ZFS_MODULE_PARAM(zfs_vdev, zfs_vdev_, queue_window_max, UINT, ZMOD_RW,
 	"Max active I/Os per vdev with queue_window, 0 for its queue depth");
+
+ZFS_MODULE_PARAM(zfs_vdev, zfs_vdev_, queue_window_rotating_us, UINT,
+	ZMOD_RW, "Latency target of queue_window on rotating media");
+
+ZFS_MODULE_PARAM(zfs_vdev, zfs_vdev_, queue_window_non_rotating_us, UINT,
+	ZMOD_RW, "Latency target of queue_window on non-rotating media");
