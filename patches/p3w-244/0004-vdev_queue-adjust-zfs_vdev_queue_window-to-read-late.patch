diff --git a/include/sys/vdev_impl.h b/include/sys/vdev_impl.h
index bce34b70807..da782995944 100644
--- a/include/sys/vdev_impl.h
+++ b/include/sys/vdev_impl.h
@@ -151,6 +151,11 @@ struct vdev_queue {
 	list_t		vq_active_list;	/* List of active I/Os. */
 	hrtime_t	vq_io_complete_ts; /* time last i/o completed */
 	hrtime_t	vq_io_delta_ts;
+	hrtime_t	vq_win_start;	/* window: start of the period */
+	uint32_t	vq_win_depth;	/* window: active I/Os, 0 unset */
+	uint32_t	vq_win_ios;	/* window: latency samples */
+	uint32_t	vq_win_slow;	/* window: samples over target */
+	boolean_t	vq_win_held;	/* window: an I/O was held back */
 	zio_t		vq_io_search; /* used as local for stack reduction */
 	kmutex_t	vq_lock;
 };
