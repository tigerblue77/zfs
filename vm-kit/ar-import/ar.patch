+#
+
+. $STF_SUITE/include/libtest.shlib
+
+#
+# DESCRIPTION:
+# A pool imports healthy, in place and from devices that have moved, after
+# a crash in the middle of the txg that detaches one side of a mirror, when
+# the newest labels of the remaining device do not record its former guid,
+# as code that predates it wrote them: those labels are newer than every
+# uberblock on the device, so the labels its uberblocks cover are used.
+#
+# STRATEGY:
+# 1. Create a mirror on file vdevs, export it and copy the devices
+# 2. Import the pool, detach one device, export it, then import and export
+#    it again, which writes labels without the former guid
+# 3. Put back labels 1 and 3 and every uberblock ring of the remaining
+#    device from its copy, leaving labels 0 and 2 from after the detach
+# 4. Verify that the pool imports in place, healthy with both devices
+#    online, and scrubs without errors
+# 5. Verify the same from a copy of the devices moved to another directory
+#    under other names
+#
+
+verify_runnable "global"
+
+VDEV_DIR=$TEST_BASE_DIR/detach_oldlabel
+PRE_DIR=$VDEV_DIR/pre
+CRASH_DIR=$TEST_BASE_DIR/detach_oldlabel_crash
+MOVED_DIR=$TEST_BASE_DIR/detach_oldlabel_moved
+
+function cleanup
+{
+	poolexists $TESTPOOL1 && destroy_pool $TESTPOOL1
+	rm -rf $VDEV_DIR $CRASH_DIR $MOVED_DIR
+}
+
+#
+# Copy back what a crash before the uberblocks of the detach txg leaves
+# untouched, in 128 KiB blocks: the uberblock ring of label 0 (block 1),
+# label 1 (blocks 2-3), the uberblock ring of label 2 and label 3 (the last
+# three blocks).
+#
+function restore_pre_detach # <device>
+{
+	typeset dev=$1
+	typeset -i n=$((MINVDEVSIZE / 131072))
+
+	log_must dd if=$PRE_DIR/$dev of=$VDEV_DIR/$dev bs=128k \
+	    skip=1 seek=1 count=3 conv=notrunc
+	log_must dd if=$PRE_DIR/$dev of=$VDEV_DIR/$dev bs=128k \
+	    skip=$((n - 3)) seek=$((n - 3)) count=3 conv=notrunc
+}
+
+function check_healthy # <dir> <prefix>
+{
+	typeset dir=$1
+	typeset prefix=$2
+
+	log_must check_pool_status $TESTPOOL1 "state" "ONLINE"
+	for dev in vdev0 vdev1; do
+		log_must check_vdev_state $TESTPOOL1 $dir/$prefix$dev ONLINE
+	done
+	log_must zpool scrub -w $TESTPOOL1
+	log_must check_pool_status $TESTPOOL1 "errors" "No known data errors"
+}
+
+log_assert "A pool imports healthy after a crash in the middle of" \
+    "'zpool detach' from labels without the former guid."
+log_onexit cleanup
+
+log_must mkdir -p $PRE_DIR $CRASH_DIR $MOVED_DIR
+for dev in vdev0 vdev1; do
+	log_must truncate -s $MINVDEVSIZE $VDEV_DIR/$dev
+done
+log_must zpool create $TESTPOOL1 mirror $VDEV_DIR/vdev0 $VDEV_DIR/vdev1
+log_must zpool export $TESTPOOL1
+log_must cp $VDEV_DIR/vdev0 $PRE_DIR/vdev0
+
+log_must zpool import -d $VDEV_DIR $TESTPOOL1
+log_must zpool detach $TESTPOOL1 $VDEV_DIR/vdev1
+log_must zpool export $TESTPOOL1
+log_must zpool import -d $VDEV_DIR $TESTPOOL1
+log_must zpool export $TESTPOOL1
+log_mustnot eval "zdb -l $VDEV_DIR/vdev0 | grep -q orig_guid"
+
+restore_pre_detach vdev0
+for dev in vdev0 vdev1; do
+	log_must cp $VDEV_DIR/$dev $CRASH_DIR/$dev
+done
+
+log_must zpool import -d $VDEV_DIR $TESTPOOL1
+check_healthy $VDEV_DIR ""
+log_must zpool export $TESTPOOL1
+log_must rm $VDEV_DIR/vdev0 $VDEV_DIR/vdev1
+
+for dev in vdev0 vdev1; do
+	log_must mv $CRASH_DIR/$dev $MOVED_DIR/moved_$dev
+done
+log_must zpool import -d $MOVED_DIR $TESTPOOL1
+check_healthy $MOVED_DIR "moved_"
+
+log_pass "A pool imports healthy after a crash in the middle of" \
+    "'zpool detach' from labels without the former guid."
