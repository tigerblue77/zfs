 zutil_pool_active(libpc_handle_t *hdl, const char *name, uint64_t guid,
     boolean_t *isactive)
@@ -902,7 +936,7 @@ get_configs(libpc_handle_t *hdl, pool_list_t *pl, boolean_t active_ok,
 		 * Go through and fix up any paths and/or devids based on our
 		 * known list of vdev GUID -> path mappings.
 		 */
-		if (fix_paths(hdl, nvroot, pl->names, pe->pe_guid) != 0) {
+		if (fix_paths(hdl, nvroot, pl, pe->pe_guid) != 0) {
