+/*
+ * vdev_config_sync() writes labels 0 and 2 before the uberblocks of their
+ * txg, so a crash in between leaves labels that no uberblock on the device
+ * covers, describing a change the pool never committed.  A leaf that a detach
+ * left alone in its parent then names itself by the guid of the parent, and
+ * code that predates ZPOOL_CONFIG_ORIG_GUID in such labels gave no other.
+ * When label is newer than every uberblock on vd, return the newest label
+ * that one covers if it names vd as the trusted config does, or NULL.
+ */
+static nvlist_t *
+vdev_validate_committed_label(vdev_t *vd, nvlist_t *label)
+{
+	uint64_t label_txg, ub_txg, txg, guid;
+	nvlist_t *older;
+
+	if (nvlist_lookup_uint64(label, ZPOOL_CONFIG_POOL_TXG,
+	    &label_txg) != 0)
+		return (NULL);
+
+	ub_txg = vdev_uberblock_newest_txg(vd);
+	if (ub_txg == 0 || label_txg <= ub_txg)
+		return (NULL);
+
+	older = vdev_label_read_config(vd, ub_txg, VDEV_TRUSTED_LABELS(vd));
+	if (older == NULL)
+		return (NULL);
+
+	if (nvlist_lookup_uint64(older, ZPOOL_CONFIG_POOL_TXG, &txg) != 0 ||
+	    txg == 0 || txg > ub_txg ||
+	    nvlist_lookup_uint64(older, ZPOOL_CONFIG_POOL_GUID, &guid) != 0 ||
+	    guid != spa_guid(vd->vdev_spa) ||
+	    nvlist_lookup_uint64(older, ZPOOL_CONFIG_GUID, &guid) != 0 ||
+	    guid != vd->vdev_guid ||
+	    nvlist_lookup_uint64(older, ZPOOL_CONFIG_TOP_GUID, &guid) != 0 ||
+	    guid != vd->vdev_top->vdev_guid) {
+		nvlist_free(older);
+		return (NULL);
+	}
+
+	vdev_dbgmsg(vd, "vdev_validate: label of txg %llu is newer than "
+	    "every uberblock of the device (txg %llu); using the label of "
+	    "txg %llu", (u_longlong_t)label_txg, (u_longlong_t)ub_txg,
+	    (u_longlong_t)txg);
+	return (older);
