. $STF_SUITE/include/libtest.shlib

typeset POOL=$TESTPOOL1

typeset SPECIAL

#
# Create pool $POOL on files in directory $1: a raidz vdev and a special
# mirror, which takes the metadata, with the other arguments as options.
# Set SPECIAL to the name of the special mirror.
#
function rewrite_create_pool # dir [options...]
{
	typeset dir=$1

	shift
	log_must truncate -s $MINVDEVSIZE $dir/r0 $dir/r1 $dir/r2 $dir/s0 \
	    $dir/s1
	log_must zpool create -f "$@" $POOL raidz $dir/r0 $dir/r1 $dir/r2 \
	    special mirror $dir/s0 $dir/s1
	SPECIAL=$(zpool status $POOL | \
	    awk '/special/ { found = 1 } found && /mirror-/ { print $1; exit }')
	[[ -n "$SPECIAL" ]] || log_fail "Could not find the special mirror"
}

#
# Wait for nothing to be allocated on vdev $2 of pool $1, for $3 seconds at
# most, syncing the pool so that the frees land.  Return 1 if something
# still is.
#
function rewrite_wait_empty # pool vdev seconds
{
	typeset -i i

	for ((i = 0; i < $3; i++)); do
		sync_pool $1 true
		[ "$(get_vdev_prop allocated $1 $2)" -eq 0 ] && return 0
		sleep 1
	done
	log_note "$(get_vdev_prop allocated $1 $2) still allocated on $2"
	return 1
}

# Print the checksums of the files under the directories given.
function rewrite_contents # dir...
{
	typeset f

	find "$@" -type f | sort | while read -r f; do
		echo "$(xxh128digest $f) $f"
	done
}

#
# Remove vdev $2 of pool $1, which nothing is allocated on.  Return 2 if this
# build can not remove it, which it can not beside a raidz vdev without the
# support for removing an empty vdev as a hole.
#
function rewrite_remove_empty # pool vdev
{
	typeset out

	out=$(zpool remove $1 $2 2>&1) && return 0
	log_note "zpool remove $1 $2: $out"
	echo "$out" | grep -q "not be raidz" && return 2
	return 1
}

#
# Verify that the vdev removed from pool $1 became a hole: no indirect vdev,
# and the device_removal and obsolete_counts features not active.
#
function rewrite_check_hole # pool
{
	log_mustnot eval "zpool status $1 | grep -q indirect"
	log_mustnot eval "zdb -C $1 | grep -q \"type: 'indirect'\""
	log_must eval "zdb -C $1 | grep -q \"type: 'hole'\""
	log_must [ "$(get_pool_prop feature@device_removal $1)" = enabled ]
	log_mustnot [ "$(get_pool_prop feature@obsolete_counts $1)" = active ]
}
