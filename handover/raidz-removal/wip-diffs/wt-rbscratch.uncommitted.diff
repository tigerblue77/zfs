  */
 static __attribute__((noreturn)) void vdev_rebuild_thread(void *arg);
+
+/* SCRATCH toggles and counters for the rebuild probes; not for upstream. */
+int rbw_thread_fix = 0;
+int rbw_sync_fix = 0;
+int rbw_verify_soft = 0;
+uint64_t rbw_cancels;
+uint64_t rbw_initiates;
+uint64_t rbw_resets;
+uint64_t rbw_initiate_unneeded;
+uint64_t rbw_reset_unneeded;
+uint64_t rbw_unneeded_closed;
+hrtime_t rbw_fail_ns;
+hrtime_t rbw_task_start_ns;
+uint64_t rbw_unneeded_other;
+
+/* SCRATCH: classify the leaves holding DTL_MISSING when a check fails. */
+static void
+rbw_note_unneeded(vdev_t *vd)
+{
+	int closed = 0, other = 0;
+	vdev_t *stack[64];
+	int n = 0;
+
+	stack[n++] = vd;
+	while (n > 0) {
+		vdev_t *v = stack[--n];
+		if (v->vdev_ops->vdev_op_leaf) {
+			if (zfs_range_tree_is_empty(v->vdev_dtl[DTL_MISSING]))
+				continue;
+			if (v->vdev_state == VDEV_STATE_CLOSED)
+				closed++;
+			else
+				other++;
+			continue;
+		}
+		for (uint64_t c = 0; c < v->vdev_children && n < 64; c++)
+			stack[n++] = v->vdev_child[c];
+	}
+	if (closed > 0 && other == 0)
+		rbw_unneeded_closed++;
+	else
+		rbw_unneeded_other++;
+}
