+/* PROTO: whether the vdev tree names this vdev guid */
+static boolean_t
+tree_has_guid(nvlist_t *nv, uint64_t guid)
+{
+	nvlist_t **child;
+	uint_t c, children;
+	uint64_t g;
+
+	if (nvlist_lookup_uint64(nv, ZPOOL_CONFIG_GUID, &g) == 0 && g == guid)
+		return (B_TRUE);
+	if (nvlist_lookup_nvlist_array(nv, ZPOOL_CONFIG_CHILDREN,
+	    &child, &children) != 0)
+		return (B_FALSE);
+	for (c = 0; c < children; c++)
+		if (tree_has_guid(child[c], guid))
+			return (B_TRUE);
+	return (B_FALSE);
+}
+
+/*
+ * PROTO: paths of the devices of this pool that the scan found but that the
+ * assembled tree does not name, keyed by vdev guid.
+ */
+static void
+add_leaf_paths(nvlist_t *config, nvlist_t *nvroot, name_entry_t *names,
+    name_entry_t *txg0_names, uint64_t pool_guid)
+{
+	nvlist_t *paths = fnvlist_alloc();
+	name_entry_t *lists[2] = { names, txg0_names };
+	char key[32];
+
+	for (int i = 0; i < 2; i++) {
+		for (name_entry_t *ne = lists[i]; ne != NULL;
+		    ne = ne->ne_next) {
+			if (ne->ne_pool_guid != pool_guid ||
+			    tree_has_guid(nvroot, ne->ne_guid))
+				continue;
+			(void) snprintf(key, sizeof (key), "%llu",
+			    (u_longlong_t)ne->ne_guid);
+			if (!nvlist_exists(paths, key))
+				fnvlist_add_string(paths, key, ne->ne_name);
+		}
+	}
+	if (!nvlist_empty(paths))
+		fnvlist_add_nvlist(config, ZPOOL_CONFIG_LEAF_PATHS, paths);
+	fnvlist_free(paths);
+}
