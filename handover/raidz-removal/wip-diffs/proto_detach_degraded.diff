+/*
+ * PROTO: give a leaf of the destination tree that the source tree does not
+ * name, by guid or former guid, the path the scan found its device at.
+ */
+void
+vdev_copy_path_extra(vdev_t *srvd, vdev_t *dvd, nvlist_t *paths)
+{
+	const char *path;
+	char key[32];
+
+	for (uint64_t c = 0; c < dvd->vdev_children; c++)
+		vdev_copy_path_extra(srvd, dvd->vdev_child[c], paths);
+
+	if (!dvd->vdev_ops->vdev_op_leaf || !vdev_is_concrete(dvd) ||
+	    vdev_lookup_by_guid(srvd, dvd->vdev_guid) != NULL ||
+	    vdev_lookup_by_orig_guid(srvd, dvd->vdev_guid) != NULL)
+		return;
+
+	(void) snprintf(key, sizeof (key), "%llu",
+	    (u_longlong_t)dvd->vdev_guid);
+	if (nvlist_lookup_string(paths, key, &path) != 0)
+		return;
+	zfs_dbgmsg("vdev_copy_path_extra: vdev %llu from leaf_paths",
+	    (u_longlong_t)dvd->vdev_guid);
+	vdev_update_path("vdev_path", (char *)path, &dvd->vdev_path,
+	    dvd->vdev_guid);
+}
