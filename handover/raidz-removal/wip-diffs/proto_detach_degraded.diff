+/*
+ * PROTO: the pool and vdev guids of a label left with txg 0, as the labels a
+ * detach or a removal "erases" are.  Returns 0 when one is found.
+ */
+int
+zutil_read_txg0_label(int fd, uint64_t *pool_guid, uint64_t *guid)
+{
+	struct stat64 statbuf;
+	vdev_phys_t *label;
+	uint64_t size, txg;
+	nvlist_t *nv;
+	int ret = -1;
+
+	if (fstat64_blk(fd, &statbuf) == -1)
+		return (-1);
+	size = P2ALIGN_TYPED(statbuf.st_size, sizeof (vdev_label_t), uint64_t);
+	label = (vdev_phys_t *)kmem_alloc_aligned(sizeof (*label), PAGESIZE,
+	    KM_NOSLEEP);
+	if (label == NULL)
+		return (-1);
+	for (int l = 0; l < VDEV_LABELS && ret != 0; l++) {
+		if (pread64(fd, label, sizeof (vdev_phys_t),
+		    label_offset(size, l) + VDEV_SKIP_SIZE) !=
+		    sizeof (vdev_phys_t))
+			continue;
+		if (nvlist_unpack(label->vp_nvlist,
+		    sizeof (label->vp_nvlist), &nv, 0) != 0)
+			continue;
+		if (nvlist_lookup_uint64(nv, ZPOOL_CONFIG_POOL_TXG,
+		    &txg) == 0 && txg == 0 &&
+		    nvlist_lookup_uint64(nv, ZPOOL_CONFIG_POOL_GUID,
+		    pool_guid) == 0 &&
+		    nvlist_lookup_uint64(nv, ZPOOL_CONFIG_GUID, guid) == 0 &&
+		    *pool_guid != 0 && *guid != 0)
+			ret = 0;
+		nvlist_free(nv);
+	}
+	kmem_free_aligned(label, sizeof (*label));
+	return (ret);
+}
